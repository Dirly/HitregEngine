{
  // The authoring tools (`tools/*.mts`, the zonegen commands) and the node tests (`test/*.test.ts`) are outside the
  // app's `"include": ["src"]`, so `tsc --noEmit` on tsconfig.json reported nothing about them: a tool could import a
  // name a module never exported and `pnpm typecheck` stayed green (found 2026-10-28 building worldgen coast).
  // `pnpm -F playground typecheck` runs this one too.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["tools/worldgen-coast.mts", "test/worldgen-coast.test.ts", "tools/_stage-stamp.mts", "test/stage-stamp.test.ts", "tools/worldgen-relief.mts", "test/worldgen-relief.test.ts", "tools/worldgen-dogfood.mts", "tools/worldgen-dogfood-needs.mts", "tools/site-needs.mts", "tools/worldgen-site-needs.mts", "tools/worldgen-coast-shape.mts", "tools/worldgen-biome-read.mts", "test/worldgen-coast-shape.test.ts", "tools/_map-text.mts", "tools/worldgen-climate.mts", "tools/worldgen-coastal-towns.mts", "test/worldgen-coastal-towns.test.ts", "tools/armor.mts", "tools/armor-codex/*.mts", "test/armor-codex.test.ts", "tools/_concept-site.mts", "tools/zonegen/commands/concept.mts", "test/concept-site.test.ts", "tools/_far-camera.mts", "tools/worldgen-scene-env.mts", "test/far-camera.test.ts", "tools/world-order.mts", "tools/zonegen/commands/stages.mts", "tools/zonegen/commands/approve.mts", "tools/_exterior.mts", "tools/zonegen/commands/concept-check.mts", "tools/zonegen/commands/exterior.mts", "test/exterior-guard.test.ts", "test/world-order.test.ts", "tools/game-shell.mts", "test/game-shell.test.ts", "tools/_lab-crop.mts", "test/lab-crop.test.ts", "tools/_world-spawn.mts", "tools/_road-network.mts", "tools/_site-paths.mts", "test/site-paths.test.ts", "tools/worldgen-road-net.mts", "test/road-network.test.ts", "tools/_iso-views.mts", "test/iso-views.test.ts", "tools/_render-batch.mts", "test/render-batch.test.ts", "test/human-template.test.ts", "tools/names.mts", "tools/town-npcs.mts", "test/names.test.ts", "test/populate-scale.test.ts", "tools/_scene-sync.mts", "test/scene-sync.test.ts", "tools/_owner-edit-bridge.mts", "test/owner-edit-bridge.test.ts", "tools/_agent-activity.mts", "tools/agent-activity.mts"]
}
