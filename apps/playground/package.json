{
  "name": "playground",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && node tools/typecheck-projects.mjs",
    "build:game": "node tools/publish.mjs",
    "typecheck:projects": "node tools/typecheck-projects.mjs",
    "place": "tsx tools/place.mts",
    "worldgen": "tsx tools/worldgen.mts",
    "retarget": "node tools/retarget.mjs",
    "autorig": "node tools/autorig.mjs",
    "unwrap-weapon": "node tools/unwrap-weapon.mjs",
    "atlas-view": "node tools/atlas-view.mjs",
    "atlas-pack": "node tools/atlas-pack.mjs",
    "wfc": "node ../../tools/wfc-3d/kit.mjs",
    "dungeon": "tsx tools/dungeon.mts"
  },
  "dependencies": {
    "@hitreg/comms": "workspace:*",
    "@hitreg/core": "workspace:*",
    "@hitreg/editor": "workspace:^",
    "@hitreg/net": "workspace:*",
    "@hitreg/physics": "workspace:^",
    "@hitreg/render": "workspace:*",
    "@hitreg/scripting": "workspace:^",
    "camera-controls": "^3.1.2",
    "three": "^0.185.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.4"
  }
}
