{
  "name": "playground",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json && node tools/typecheck-projects.mjs",
    "build:game": "node tools/publish.mjs",
    "preview:game": "vite preview --port 4180 --strictPort --outDir",
    "typecheck:projects": "node tools/typecheck-projects.mjs",
    "place": "tsx tools/place.mts",
    "worldgen": "tsx tools/worldgen.mts",
    "retarget": "node tools/retarget.mjs",
    "hands": "node tools/humanoid-hands.mjs",
    "autorig": "node tools/autorig.mjs",
    "legrig": "node tools/legrig.mjs",
    "unwrap-weapon": "node tools/unwrap-weapon.mjs",
    "atlas-view": "node tools/atlas-view.mjs",
    "atlas-pack": "node tools/atlas-pack.mjs",
    "weapon-page": "node tools/weapon-page.mjs",
    "wfc": "node ../../tools/wfc-3d/kit.mjs",
    "dungeon": "tsx tools/dungeon.mts",
    "dress": "tsx tools/dress.mts",
    "props": "tsx tools/props.mts",
    "zonegen": "tsx tools/zonegen.mts",
    "settle": "tsx tools/settle.mts"
  },
  "dependencies": {
    "@hitreg/comms": "workspace:*",
    "@hitreg/core": "workspace:*",
    "@hitreg/editor": "workspace:^",
    "@hitreg/net": "workspace:*",
    "@hitreg/physics": "workspace:^",
    "@hitreg/render": "workspace:*",
    "@hitreg/scripting": "workspace:^",
    "camera-controls": "^3.1.2",
    "three": "^0.185.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.185.1",
    "playwright": "1.47.2",
    "sharp": "0.34.3",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.4"
  }
}
