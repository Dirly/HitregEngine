{
  "version": 1,
  "name": "Streetlight",
  "root": "pole",
  "entities": {
    "pole": {
      "name": "Pole",
      "parent": null,
      "tags": ["streetlight"],
      "components": {
        "transform": {},
        "mesh": {
          "source": { "kind": "primitive", "shape": "cylinder", "size": [0.2, 4, 0.2] }
        }
      }
    },
    "lamp": {
      "name": "Lamp",
      "parent": "pole",
      "tags": [],
      "components": {
        "transform": { "position": [0, 4, 0], "rotation": [0, 0, 0, 1], "scale": [1, 1, 1] },
        "mesh": {
          "source": { "kind": "primitive", "shape": "sphere", "size": [0.5, 0.5, 0.5] },
          "castShadow": false
        },
        "light": { "kind": "point", "intensity": 30, "range": 18 }
      }
    }
  },
  "props": {
    "lightColor": {
      "default": "#ffcc88",
      "bindings": ["lamp/components/light/color"],
      "label": "Bulb color",
      "group": "Light",
      "description": "Color of the lamp's point light"
    },
    "intensity": {
      "default": 30,
      "bindings": ["lamp/components/light/intensity"],
      "label": "Brightness",
      "group": "Light",
      "min": 0,
      "max": 120,
      "step": 1,
      "unit": "cd",
      "description": "How hard the bulb burns."
    },
    "range": {
      "default": 18,
      "bindings": ["lamp/components/light/range"],
      "label": "Falloff",
      "group": "Light",
      "min": 1,
      "max": 60,
      "unit": "m",
      "description": "Distance at which the light reaches zero."
    },
    "castShadow": {
      "default": false,
      "bindings": ["lamp/components/mesh/castShadow"],
      "label": "Lamp casts shadow",
      "group": "Light",
      "advanced": true,
      "description": "Off by default — a shadow per streetlight is rarely worth the draw."
    }
  }
}
