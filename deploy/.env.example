# copy to deploy/.env and edit — docker compose reads it with --env-file

# the cluster secret: signs play tickets, admits layers. Long and random.
HITREG_SECRET=change-me-to-something-long-and-random
# bearer for /admin/* (defaults to the secret if empty)
HITREG_ADMIN_TOKEN=

# what browsers dial: the box's DNS name (Caddy gets a certificate for it)
PUBLIC_HOST=play.example.org
# wss behind Caddy's per-port TLS fronts; ws if you expose layer ports raw
PUBLIC_SCHEME=wss

# the world scene every layer hosts (a scene in apps/playground/projects/<game>/assets/scenes)
SCENE=mmo
# The project passed to build:game. Caddy serves dist/<project>, never the editor's dist/index.html.
CLIENT_PROJECT=your-game

# layer pool: players per layer, layers kept / at most, published port range
CAP=40
MIN_LAYERS=1
MAX_LAYERS=4
LAYER_PORTS=8801-8810

# extra flags for every layer process (worker threads for terrain cooking, sim rate …)
MAIN_ARGS=--child-args "--workers 2"

# Postgres (the compose file runs one); leave HITREG_DATABASE_URL empty to use files under /data
POSTGRES_PASSWORD=hitreg
HITREG_DATABASE_URL=
